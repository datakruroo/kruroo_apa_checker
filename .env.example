# Copy this file to .env and fill in local keys.
# Do not commit .env to GitHub.

# Required for the Streamlit app and LLM-polished researcher report text.
OPENAI_API_KEY=

# Optional. Required only when uploading PDF files.
# DOCX checking works without LlamaCloud.
LLAMA_CLOUD_API_KEY=

# Optional. Currently not used by the main verification flow.
# Reserved for future web-search fallback.
BRAVE_SEARCH_API_KEY=

# Optional model settings.
OPENAI_MODEL=gpt-5.4-mini
REPORT_WRITER_MODEL=gpt-5.1

# Optional paths.
# CHECKLIST_PATH=checklists/apa_chula_2568.md
# OUTPUT_DIR=outputs
